# Required
DATABASE_URL=postgresql://user:password@localhost:5432/campusscope

# Optional
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
CRON_SECRET=
ADMIN_EMAILS=

# Ingestion / provenance
DTE_CUTOFF_URL=
INGEST_SOURCE=

# Ask engine (falls back to deterministic rules when unset)
CAMPUSLM_URL=
CAMPUSLM_MODEL=
CAMPUSLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Growth loop
RESEND_API_KEY=
RESEND_FROM=

# SEO / share cards
NEXT_PUBLIC_SITE_URL=https://campusscope.vercel.app

# Optional observability (install @sentry/nextjs first)
SENTRY_DSN=
