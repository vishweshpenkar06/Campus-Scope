# Required
DATABASE_URL=postgresql://user:password@localhost:5432/campusscope

# Optional locally; AUTH_SECRET is required in production
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
CRON_SECRET=
ADMIN_EMAILS=

# Ingestion / provenance
DTE_CUTOFF_URL=
INGEST_SOURCE=

# Ask engine (falls back to deterministic rules when unset)
CAMPUSLM_URL=
CAMPUSLM_MODEL=
CAMPUSLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Growth loop
RESEND_API_KEY=
RESEND_FROM=

# SEO / share cards
NEXT_PUBLIC_SITE_URL=https://campusscope.vercel.app

# Optional observability (package is installed; set the DSN to enable)
SENTRY_DSN=

# Only for a deliberate demo database; never in production
ALLOW_DESTRUCTIVE_SEED=

# Recommended for production rate limiting (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
