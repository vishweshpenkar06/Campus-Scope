generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id                    Int                  @id @default(autoincrement())
  instituteCode         String?              @unique
  name                  String
  location              String
  fees                  Int
  rating                Float
  overview              String
  websiteUrl            String               @default("")
  admissionUrl          String               @default("")
  establishedYear       Int                  @default(0)
  campusSize            String               @default("")
  accreditation         String               @default("")
  hostelFees            Int                  @default(0)
  hostelAvailable       Boolean              @default(false)
  facilities            String               @default("[]")
  cautionDeposit        Int                  @default(0)
  eligibleScholarships  String               @default("[]")
  topRecruiters         String               @default("[]")
  studentFacultyRatio   String               @default("")
  nirfRank              Int                  @default(0)
  autonomous            Boolean              @default(false)
  ebcConcessionPct      Int                  @default(50)
  tfwsConcessionPct     Int                  @default(100)
  scStConcessionPct     Int                  @default(100)
  minorityConcessionPct Int                  @default(30)
  sourceUrl             String?
  sourceName            String?
  sourceDate            DateTime?
  verifiedAt            DateTime?
  verifiedBy            String?
  confidence            Float                @default(1.0)
  photoUrl              String?
  photoCredit           String?
  photoLicense          String?
  photoSourceUrl        String?
  photoIllustrative     Boolean              @default(false)
  createdAt             DateTime             @default(now())
  courses               Course[]
  placements            Placement[]
  reviews               Review[]
  cutoffs               Cutoff[]
  correctionRequests    CorrectionRequest[]
  capRoundTrends        CapRoundTrend[]
  seatMatrices          SeatMatrix[]
  campusInsights        CampusInsight[]
  spotRoundNotices      SpotRoundNotice[]
  peerRequests          PeerConnectRequest[]
  savedBy               SavedCollege[]
  mentorSlots           MentorSlot[]
  forumPosts            ForumPost[]

  @@index([name])
  @@index([location])
  @@index([location, fees])
  @@index([rating])
}

// Auth.js identity tables (JWT sessions; Account/Session kept for OAuth bookkeeping)
model User {
  id                String               @id @default(cuid())
  name              String?
  email             String?              @unique
  emailVerified     DateTime?
  image             String?
  exam              String?
  percentile        Float?
  category          String               @default("OPEN")
  accounts          Account[]
  sessions          Session[]
  savedColleges     SavedCollege[]
  applications      ApplicationTracker[]
  peerRequests      PeerConnectRequest[]
  spotApplications  SpotApplication[]
  notifications     Notification[]
  mentorSlots       MentorSlot[]         @relation("MentorSlots")
  slotBookings      Booking[]            @relation("SlotBookings")
  forumPosts        ForumPost[]
  forumComments     ForumComment[]
  forumVotes        ForumVote[]
  counsellorProfile CounsellorProfile?
  leads             Lead[]
  alerts            AlertPreference[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Official-source registry and the review queue. Nothing reaches published
// cutoff/trend/seat tables until a human approves its staging record.
model DataSource {
  id        Int             @id @default(autoincrement())
  name      String
  url       String
  license   String?
  lastRunAt DateTime?
  status    String          @default("active")
  createdAt DateTime        @default(now())
  records   StagingRecord[]

  @@unique([name])
}

model StagingRecord {
  id         Int        @id @default(autoincrement())
  sourceId   Int
  externalId String
  rawJson    Json
  status     String     @default("pending")
  reason     String?
  createdAt  DateTime   @default(now())
  reviewedAt DateTime?
  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([status, createdAt])
}

model SavedCollege {
  id           Int      @id @default(autoincrement())
  userId       String
  collegeId    Int
  targetBranch String
  category     String   @default("OPEN")
  priority     Int      @default(0)
  status       String   @default("Researching")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId, priority])
}

model ApplicationTracker {
  id        String   @id @default(cuid())
  userId    String
  collegeId Int?
  label     String
  round     String
  status    String   @default("Pending")
  notes     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PeerConnectRequest {
  id           Int      @id @default(autoincrement())
  studentId    String
  collegeId    Int
  targetBranch String
  status       String   @default("Pending")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([studentId])
}

model SpotRoundNotice {
  id                  Int               @id @default(autoincrement())
  collegeId           Int
  branch              String
  vacancyCount        Int
  applicationDeadline DateTime
  noticePdfUrl        String            @default("")
  publishedAt         DateTime          @default(now())
  college             College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  applications        SpotApplication[]

  @@index([applicationDeadline])
  @@index([collegeId])
}

model SpotApplication {
  id          Int             @id @default(autoincrement())
  userId      String
  noticeId    Int
  status      String          @default("Applying")
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice      SpotRoundNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  dedupeKey String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, read, createdAt])
}

model MentorSlot {
  id          Int       @id @default(autoincrement())
  mentorId    String
  collegeId   Int
  startTime   DateTime
  durationMin Int       @default(15)
  status      String    @default("Open")
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  mentor      User      @relation("MentorSlots", fields: [mentorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([collegeId, status, startTime])
}

model Booking {
  id          Int        @id @default(autoincrement())
  slotId      Int        @unique
  candidateId String
  status      String     @default("Confirmed")
  createdAt   DateTime   @default(now())
  slot        MentorSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  candidate   User       @relation("SlotBookings", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model ForumPost {
  id             Int            @id @default(autoincrement())
  collegeId      Int
  userId         String
  title          String
  content        String
  upvotes        Int            @default(0)
  isSeniorAnswer Boolean        @default(false)
  createdAt      DateTime       @default(now())
  college        College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       ForumComment[]
  voters         ForumVote[]

  @@index([collegeId, createdAt])
  @@index([collegeId, upvotes])
}

model ForumComment {
  id             Int         @id @default(autoincrement())
  postId         Int
  userId         String
  content        String
  isSeniorAnswer Boolean     @default(false)
  createdAt      DateTime    @default(now())
  post           ForumPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  voters         ForumVote[]

  @@index([postId, createdAt])
}

// ponytail: single vote table for posts and comments (nullable opposite side) instead of two tables
model ForumVote {
  id        Int           @id @default(autoincrement())
  userId    String
  postId    Int?
  commentId Int?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// ponytail: one generic event table for all lightweight telemetry (search/simulator/docs) instead of
// three tables; if volume ever demands it, partition by `type` or move to a real analytics store.
model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  type      String
  label     String
  value     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([type, label])
}

model Course {
  id        Int     @id @default(autoincrement())
  collegeId Int
  name      String
  duration  String
  fees      Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Placement {
  id             Int       @id @default(autoincrement())
  collegeId      Int
  year           Int
  avgPackage     Float
  highestPackage Float
  placementRate  Float
  sourceUrl      String?
  sourceName     String?
  sourceDate     DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  confidence     Float     @default(1.0)
  college        College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, year])
}

model Review {
  id        Int      @id @default(autoincrement())
  collegeId Int
  author    String
  rating    Float
  comment   String
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Cutoff {
  id               Int             @id @default(autoincrement())
  collegeId        Int
  exam             String
  capRound         Int
  category         String
  categoryCode     String?
  branch           String
  branchCode       String?
  percentile       Float
  rank             Int?
  stage            String?
  level            String?
  seatType         String?
  year             Int
  sourcePage       Int?
  sourceDocumentId Int?
  sourceUrl        String?
  sourceName       String?
  sourceDate       DateTime?
  verifiedAt       DateTime?
  verifiedBy       String?
  confidence       Float           @default(1.0)
  college          College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  corrections      CorrectionRequest[]

  @@index([collegeId, branch, exam, year, category])
  @@index([exam, category, branch])
  @@index([percentile])
  @@index([verifiedAt])
  @@index([sourceDocumentId])
  @@index([collegeId, year, capRound])
}

model CorrectionRequest {
  id        Int      @id @default(autoincrement())
  collegeId Int?
  cutoffId  Int?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  cutoff    Cutoff?  @relation(fields: [cutoffId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model SourceDocument {
  id           Int       @id @default(autoincrement())
  url          String    @unique
  title        String
  year         Int
  capRound     Int
  seatType     String    @default("Maharashtra")
  sha256       String
  pageCount    Int?
  rowsImported Int       @default(0)
  fetchedAt    DateTime  @default(now())
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  cutoffs      Cutoff[]

  @@index([year, capRound])
}

// ponytail: College.fees doubles as annual tuitionFee and hostelFees as hostelFee — no duplicate columns.
model CapRoundTrend {
  id              Int       @id @default(autoincrement())
  collegeId       Int
  year            Int
  exam            String
  category        String
  branch          String
  round1Cutoff    Float
  round2Cutoff    Float
  round3Cutoff    Float
  spotRoundCutoff Float?
  sourceUrl       String?
  sourceName      String?
  sourceDate      DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  confidence      Float     @default(1.0)
  college         College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, year, exam, category, branch])
  @@index([exam, category, branch])
  @@index([collegeId, branch, year])
}

model SeatMatrix {
  id            Int       @id @default(autoincrement())
  collegeId     Int
  branch        String
  totalSeats    Int
  openSeats     Int
  obcSeats      Int
  scSeats       Int
  stSeats       Int
  tfwsSeats     Int
  allIndiaSeats Int
  sourceUrl     String?
  sourceName    String?
  sourceDate    DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  confidence    Float     @default(1.0)
  college       College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, branch])
}

model CampusInsight {
  id                   Int      @id @default(autoincrement())
  collegeId            Int
  authorRole           String
  attendanceStrictness String
  canteenRating        Float
  placementSupport     String
  content              String
  createdAt            DateTime @default(now())
  college              College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model AdmissionDeadline {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  eventDate    DateTime
  category     String
  officialLink String   @default("")

  @@index([eventDate])
}

// Growth loop: directory of human counsellors and the leads students send them.
model CounsellorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  city        String
  languages   String[]
  verified    Boolean  @default(false)
  bio         String
  priceRange  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads       Lead[]

  @@index([city, verified])
}

model Lead {
  id           String             @id @default(cuid())
  studentId    String?
  counsellorId String?
  name         String
  phone        String
  percentile   Float?
  category     String?
  message      String
  status       String             @default("new")
  createdAt    DateTime           @default(now())
  student      User?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  counsellor   CounsellorProfile? @relation(fields: [counsellorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([counsellorId, createdAt])
}

model AlertPreference {
  id         Int      @id @default(autoincrement())
  userId     String?
  identifier String   @unique
  channel    String   @default("email")
  types      String   @default("deadline,cutoff,spot")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([active, channel])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  page      String   @default("")
  rating    Int?
  message   String
  email     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
