generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id                   Int         @id @default(autoincrement())
  name                 String
  location             String
  fees                 Int
  rating               Float
  overview             String
  websiteUrl           String      @default("")
  admissionUrl         String      @default("")
  establishedYear      Int         @default(0)
  campusSize           String      @default("")
  accreditation        String      @default("")
  hostelFees           Int         @default(0)
  hostelAvailable      Boolean     @default(false)
  facilities           String      @default("[]")
  cautionDeposit       Int         @default(0)
  eligibleScholarships String      @default("[]")
  topRecruiters        String      @default("[]")
  studentFacultyRatio  String      @default("")
  nirfRank             Int         @default(0)
  autonomous           Boolean     @default(false)
  ebcConcessionPct     Int         @default(50)
  tfwsConcessionPct    Int         @default(100)
  scStConcessionPct    Int         @default(100)
  minorityConcessionPct Int        @default(30)
  createdAt            DateTime    @default(now())
  courses              Course[]
  placements           Placement[]
  reviews              Review[]
  cutoffs              Cutoff[]
  capRoundTrends       CapRoundTrend[]
  seatMatrices         SeatMatrix[]
  campusInsights       CampusInsight[]
  spotRoundNotices     SpotRoundNotice[]
  peerRequests         PeerConnectRequest[]
  savedBy              SavedCollege[]

  @@index([name])
  @@index([location])
  @@index([location, fees])
  @@index([rating])
}

// Auth.js identity tables (JWT sessions; Account/Session kept for OAuth bookkeeping)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  exam          String?
  percentile    Float?
  category      String    @default("OPEN")
  accounts      Account[]
  sessions      Session[]
  savedColleges SavedCollege[]
  applications  ApplicationTracker[]
  peerRequests  PeerConnectRequest[]
  spotApplications SpotApplication[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model SavedCollege {
  id           Int      @id @default(autoincrement())
  userId       String
  collegeId    Int
  targetBranch String
  category     String   @default("OPEN")
  priority     Int      @default(0)
  status       String   @default("Researching")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId, priority])
}

model ApplicationTracker {
  id        String   @id @default(cuid())
  userId    String
  collegeId Int?
  label     String
  round     String
  status    String   @default("Pending")
  notes     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PeerConnectRequest {
  id           Int      @id @default(autoincrement())
  studentId    String
  collegeId    Int
  targetBranch String
  status       String   @default("Pending")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([studentId])
}

model SpotRoundNotice {
  id                  Int      @id @default(autoincrement())
  collegeId           Int
  branch              String
  vacancyCount        Int
  applicationDeadline DateTime
  noticePdfUrl        String   @default("")
  publishedAt         DateTime @default(now())
  college             College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  applications        SpotApplication[]

  @@index([applicationDeadline])
}

model SpotApplication {
  id          Int      @id @default(autoincrement())
  userId      String
  noticeId    Int
  status      String   @default("Applying")
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice      SpotRoundNotice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
}

// ponytail: one generic event table for all lightweight telemetry (search/simulator/docs) instead of
// three tables; if volume ever demands it, partition by `type` or move to a real analytics store.
model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  type      String
  label     String
  value     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([type, label])
}

model Course {
  id        Int     @id @default(autoincrement())
  collegeId Int
  name      String
  duration  String
  fees      Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Placement {
  id             Int     @id @default(autoincrement())
  collegeId      Int
  year           Int
  avgPackage     Float
  highestPackage Float
  placementRate  Float
  college        College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, year])
}

model Review {
  id        Int      @id @default(autoincrement())
  collegeId Int
  author    String
  rating    Float
  comment   String
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Cutoff {
  id         Int      @id @default(autoincrement())
  collegeId  Int
  exam       String
  capRound   Int
  category   String
  branch     String
  percentile Float
  year       Int
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, exam, year])
  @@index([exam, category, branch])
  @@index([percentile])
}

// ponytail: College.fees doubles as annual tuitionFee and hostelFees as hostelFee — no duplicate columns.
model CapRoundTrend {
  id              Int     @id @default(autoincrement())
  collegeId       Int
  year            Int
  exam            String
  category        String
  branch          String
  round1Cutoff    Float
  round2Cutoff    Float
  round3Cutoff    Float
  spotRoundCutoff Float?
  college         College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, year, exam, category, branch])
  @@index([exam, category, branch])
}

model SeatMatrix {
  id            Int     @id @default(autoincrement())
  collegeId     Int
  branch        String
  totalSeats    Int
  openSeats     Int
  obcSeats      Int
  scSeats       Int
  stSeats       Int
  tfwsSeats     Int
  allIndiaSeats Int
  college       College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, branch])
}

model CampusInsight {
  id                   Int      @id @default(autoincrement())
  collegeId            Int
  authorRole           String
  attendanceStrictness String
  canteenRating        Float
  placementSupport     String
  content              String
  createdAt            DateTime @default(now())
  college              College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model AdmissionDeadline {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  eventDate    DateTime
  category     String
  officialLink String   @default("")

  @@index([eventDate])
}
