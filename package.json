{
  "name": "campusscope",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && pnpm dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "build:check": "tsc --noEmit && pnpm build",
    "start": "next start",
    "prod:start": "pnpm start",
    "clean": "rm -rf .next",
    "db:push": "prisma db push",
    "db:reset": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "check": "tsx scripts/selfcheck.ts",
    "test": "vitest",
    "verify": "tsc --noEmit && pnpm check && pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prod:build": "next build",
    "backfill:provenance": "tsx scripts/backfill-provenance.ts",
    "ingest": "tsx scripts/ingest/run.ts",
    "backtest": "tsx scripts/backtest.ts",
    "eval:ask": "tsx scripts/eval-ask.ts",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "ingest:dte": "tsx scripts/ingest/run-official.ts",
    "ingest:seats": "tsx scripts/ingest/seatmatrix.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "unpdf": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.9"
}
