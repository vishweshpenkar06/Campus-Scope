{
  "name": "campusscope",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && pnpm dev",
    "build": "next build",
    "build:check": "tsc --noEmit && pnpm build",
    "start": "next start",
    "prod:start": "pnpm start",
    "clean": "rm -rf .next",
    "db:push": "prisma db push",
    "db:reset": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "check": "tsx scripts/selfcheck.ts",
    "verify": "tsc --noEmit && pnpm check",
    "lint": "next lint",
    "format": "prettier --write .",
    "prod:build": "pnpm build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3"
  }
}
